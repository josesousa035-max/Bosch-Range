{
  "name": "bosch-range-lab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "bash scripts/build-macos.sh",
    "test:desktop-web": "VITE_DESKTOP=1 npm run build && playwright test --config playwright.desktop.config.js",
    "preview:built": "node scripts/preview-built.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
